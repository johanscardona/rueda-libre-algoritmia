Algoritmo CuentaGrupo
    // 1. Definición de Variables (Perfil Estricto)
    Definir cantBicicletas, horasAlquiler, cantPersonas Como Entero;
    Definir precioRecorridoPersona Como Real;
    Definir PRECIO_HORA_BICI Como Real;
    Definir costoAlquiler, costoRecorrido, subtotal, aporteVoluntario, totalGeneral Como Real;
    Definir valorPersonaExacto, valorPersonaRedondeado Como Real;
    
    // 2. Constantes de Negocio
    PRECIO_HORA_BICI <- 10000;
    
    // 3. Entrada de datos
    Escribir "Ingrese la cantidad de personas en el grupo:";
    Leer cantPersonas;
    Escribir "Ingrese la cantidad de bicicletas a alquilar:";
    Leer cantBicicletas;
    Escribir "Ingrese la cantidad de horas de alquiler:";
    Leer horasAlquiler;
    Escribir "Ingrese el precio del recorrido por persona ($):";
    Leer precioRecorridoPersona;
    
    // 4. Proceso (Cálculos encadenados)
    costoAlquiler <- cantBicicletas * horasAlquiler * PRECIO_HORA_BICI;
    costoRecorrido <- cantPersonas * precioRecorridoPersona;
    subtotal <- costoAlquiler + costoRecorrido;
    aporteVoluntario <- subtotal * 0.10; // 10% de mantenimiento voluntario
    totalGeneral <- subtotal + aporteVoluntario;
    
    // Dividir cuenta de manera exacta
    valorPersonaExacto <- totalGeneral / cantPersonas;
    
    // Fórmula de Redondeo hacia arriba a la centena
    // Explicación: Dividimos entre 100, usamos redon o trunc+1 si hay decimales, y volvemos a multiplicar por 100.
    // En PSeInt estándar, truncar(x + 0.99) asegura el redondeo al techo entero.
    valorPersonaRedondeado <- trunc(valorPersonaExacto / 100 + 0.99) * 100;
    
    // 5. Salida (Resumen de Taquilla)
    Escribir "=============================================";
    Escribir "         RESUMEN DE CUENTA - RUEDA LIBRE     ";
    Escribir "=============================================";
    Escribir "Costo Total Alquiler Bicicletas : $", costoAlquiler;
    Escribir "Costo Total Recorrido Guiado    : $", costoRecorrido;
    Escribir "---------------------------------------------";
    Escribir "Subtotal Neto                   : $", subtotal;
    Escribir "Aporte Voluntario Mantenimiento : $", aporteVoluntario;
    Escribir "TOTAL GENERAL A PAGAR           : $", totalGeneral;
    Escribir "=============================================";
    Escribir "Valor exacto por persona        : $", valorPersonaExacto;
    Escribir "VALOR COBRADO POR PERSONA       : $", valorPersonaRedondeado, " (Redondeado a la centena)";
    Escribir "=============================================";
FinAlgoritmo
